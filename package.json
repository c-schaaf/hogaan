{
  "name": "hogaan",
  "version": "0.0.0",
  "private": true,
  "description": "WhatsApp-native leadership coaching app delivering Hamse Warfa's twelve-practice framework to Somali professionals",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts && tsx scripts/copy-assets.ts",
    "build:api": "tsc -p tsconfig.build.json && tsx scripts/copy-assets.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:web": "vitest run --config web/vitest.config.ts",
    "test:web:watch": "vitest --config web/vitest.config.ts",
    "test:routes": "vitest run --dir tests/web-api",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "pnpm test && pnpm test:web && pnpm test:routes && pnpm test:e2e",
    "lint": "eslint . --ext .ts,.tsx && prettier --check .",
    "lint:fix": "eslint . --ext .ts,.tsx --fix && prettier --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@axiomhq/js": "^1.6.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/sensible": "^6.0.1",
    "@fastify/static": "^8.0.0",
    "@fastify/view": "^11.1.1",
    "@sentry/node": "^10.51.0",
    "@supabase/supabase-js": "^2.105.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "argon2": "^0.41.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.36.0",
    "eta": "^4.6.0",
    "fastify": "^5.1.0",
    "groq-sdk": "^1.1.2",
    "jose": "^6.2.3",
    "libphonenumber-js": "^1.12.42",
    "opossum": "^9.0.0",
    "p-retry": "^8.0.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "twilio": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.9.0",
    "@types/opossum": "^8.1.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^29.1.1",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
