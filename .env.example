# Hogaan environment variables.
#
# Copy to `.env` for local development. Never commit real values.
# Fork rule (build plan §0 / D7): the fork is STAGING ONLY. Every key below
# must come from a separate staging/test account — never production.
# "TEST-MODE" marks values that must be test/sandbox keys on the fork.
#
# To try the app with NO accounts at all, you do not need this file:
#   pnpm demo
# (embedded database, sample leader, scripted coach). Demo mode ignores the
# real-service variables below even if they are set.

# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------
NODE_ENV=development            # development | test | staging | production
PORT=3000
LOG_LEVEL=info
# Public origin the app runs at. Used to build links in emails.
PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database + cache (required for the real server; not used by `pnpm demo`)
# ---------------------------------------------------------------------------
# Staging Supabase project's Postgres URL (separate project from production).
DATABASE_URL=postgresql://postgres:password@db.host.supabase.co:6543/postgres
# Either REDIS_URL (TCP) or UPSTASH_REDIS_REST_URL + TOKEN (REST). Staging Upstash database.
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 32 bytes, base64. Generate with: openssl rand -base64 32
# Encrypts names, leader-brief text, moments, outcomes and notes at rest.
ENCRYPTION_KEY_BASE64=
# Legacy (unused by /api/*; kept for older scripts).
JWT_SECRET_BASE64=
JWT_ISSUER=hogaan
JWT_AUDIENCE=hogaan-web

# ---------------------------------------------------------------------------
# Auth (Supabase Auth — staging project)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: enables fast local JWT verification.
SUPABASE_JWT_SECRET=
# Browser build (Vite reads these from the repo-root .env).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=              # staging workspace key with a spend cap
GROQ_API_KEY=                   # fallback model
VOYAGE_API_KEY=                 # embeddings (memory recall is currently off)
# Live-chat model. Default claude-haiku-4-5 (today's production model).
# D3 / P1.5: set to claude-haiku-5-5 only after it is scored on the eval set
# (`pnpm eval:coaching`) and checked against the 3-second turn budget.
LLM_CHAT_MODEL=claude-haiku-4-5
# Effort for models that support it (Haiku 5.5): low | medium | high. Default low (chat).
LLM_CHAT_EFFORT=low
# Background work (leader-brief updates, reflections): claude-opus-5-5 | claude-sonnet-5-5.
LLM_BACKGROUND_MODEL=claude-opus-5-5

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
SENTRY_DSN=
AXIOM_TOKEN=
AXIOM_DATASET=
BETTERSTACK_HEARTBEAT_URL=

# ---------------------------------------------------------------------------
# Email (Resend — use a staging/test domain)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# HMAC secret for signed unsubscribe + reflection links in emails. 32+ random bytes, base64.
EMAIL_LINK_SECRET=

# ---------------------------------------------------------------------------
# Payments (Stripe — TEST-MODE keys only on the fork: sk_test_..., whsec_...)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price id of the Personal plan ($20/month per D1), from the Stripe test dashboard.
STRIPE_PRICE_PERSONAL=

# ---------------------------------------------------------------------------
# Background jobs (optional tuning)
# ---------------------------------------------------------------------------
# Wait this long after a leader's last message before updating their brief. Default 600000 (10 min).
BRIEF_UPDATE_DELAY_MS=
# How often the in-process job runner polls for due jobs. Default 15000.
JOB_POLL_INTERVAL_MS=

# ---------------------------------------------------------------------------
# Feature flags — every new capability is OFF unless set to true.
# (In `pnpm demo` they default to ON.)
# ---------------------------------------------------------------------------
FEATURE_LEADER_BRIEF=false      # P1.1–P1.3 leader brief + "What Hogaan knows about you"
FEATURE_KNOWLEDGE_DIGEST=false  # P1.4 cached knowledge digest (needs founder-approved content)
FEATURE_MOMENTS=false           # P2.1/P2.3 moments + outcome capture
FEATURE_FOLLOWUP_EMAIL=false    # P2.2 follow-up email after a moment (opt-in per leader)
FEATURE_RATINGS=false           # P2.4 helpful / not helpful on replies
FEATURE_WEEKLY_NUDGE=false      # P2.6 opt-in weekly nudge
FEATURE_MCP=false               # P3 Hogaan MCP server at /mcp
FEATURE_BILLING=false           # P4 subscriptions + free-tier limits
FEATURE_ORGS=false              # P5 organizations, cohorts, funder report
FEATURE_MEETING_NOTES=false     # P6.2 paste meeting notes into a reflection

# ---------------------------------------------------------------------------
# Demo mode — set automatically by `pnpm demo`. Refused when NODE_ENV=production.
# ---------------------------------------------------------------------------
DEMO_MODE=false
