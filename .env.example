# Required
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Public origin the app runs at. Render: https://hogaan.onrender.com
PUBLIC_BASE_URL=http://localhost:3000

# Phase 1 — required for full server boot
DATABASE_URL=postgresql://postgres:password@db.host.supabase.co:6543/postgres
# Either provide REDIS_URL (TCP) or UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN (REST)
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 32 bytes, base64-encoded. Generate with: openssl rand -base64 32
ENCRYPTION_KEY_BASE64=
# JWT signing secret (HS256). Gates wireWebApiRoutes boot; 32+ bytes, base64.
JWT_SECRET_BASE64=
JWT_ISSUER=hogaan
JWT_AUDIENCE=hogaan-web

# Phase 1 LLM providers
ANTHROPIC_API_KEY=
GROQ_API_KEY=
VOYAGE_API_KEY=

# Phase 1.5 observability
SENTRY_DSN=
AXIOM_TOKEN=
AXIOM_DATASET=
BETTERSTACK_HEARTBEAT_URL=

# Transactional email (signup verification, password reset)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Supabase Auth (web SPA + /api/* validation)
SUPABASE_URL=
SUPABASE_ANON_KEY=
