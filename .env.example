# Required
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Public origin Twilio's signature is computed against. Render: https://hogaan.onrender.com
PUBLIC_BASE_URL=http://localhost:3000

# Phase 1 — required for full server boot
DATABASE_URL=postgresql://postgres:password@db.host.supabase.co:6543/postgres
# Either provide REDIS_URL (TCP) or UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN (REST)
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 32 bytes, base64-encoded. Generate with: openssl rand -base64 32
ENCRYPTION_KEY_BASE64=
# JWT signing secret (HS256) for sponsor-portal magic links. 32+ bytes, base64.
JWT_SECRET_BASE64=
JWT_ISSUER=hogaan
JWT_AUDIENCE=hogaan-sponsor-portal

# Phase 1 LLM providers
ANTHROPIC_API_KEY=
GROQ_API_KEY=
VOYAGE_API_KEY=

# Phase 1.5 observability
SENTRY_DSN=
AXIOM_TOKEN=
AXIOM_DATASET=
BETTERSTACK_HEARTBEAT_URL=

# Phase 9 — sponsor portal magic-link email (transport only; auth flows
# through the JWT secret above). For MVP, RESEND_FROM_EMAIL=onboarding@resend.dev.
# SPONSOR_PORTAL_BASE_URL is the public origin the magic-link callback URL
# is built against (e.g. https://hogaan.onrender.com).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
SPONSOR_PORTAL_BASE_URL=http://localhost:3000
