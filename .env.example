# Required
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Phase 1 — required for full server boot
DATABASE_URL=postgresql://postgres:password@db.host.supabase.co:6543/postgres
# Either provide REDIS_URL (TCP) or UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN (REST)
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 32 bytes, base64-encoded. Generate with: openssl rand -base64 32
ENCRYPTION_KEY_BASE64=

# Phase 1 LLM providers
ANTHROPIC_API_KEY=
GROQ_API_KEY=
VOYAGE_API_KEY=

# Phase 0.11 sandbox / Phase 3 production sender
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WEBHOOK_AUTH_TOKEN=

# Phase 1.5 observability
SENTRY_DSN=
AXIOM_TOKEN=
AXIOM_DATASET=
BETTERSTACK_HEARTBEAT_URL=
