        <bpmndi:BPMNLabel>
          <dc:Bounds x="505" y="310" width="100" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW3_Suppressed_di" bpmnElement="GW3_Suppressed" isMarkerVisible="true">
        <dc:Bounds x="690" y="335" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="665" y="310" width="100" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW4_WindowValid_di" bpmnElement="GW4_WindowValid" isMarkerVisible="true">
        <dc:Bounds x="850" y="335" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="825" y="310" width="100" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW5_IsTemplate_di" bpmnElement="GW5_IsTemplate" isMarkerVisible="true">
        <dc:Bounds x="1010" y="335" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="985" y="310" width="100" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW6_TemplateValid_di" bpmnElement="GW6_TemplateValid" isMarkerVisible="true">
        <dc:Bounds x="1170" y="335" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1145" y="310" width="100" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_MergeToRateLimit_di" bpmnElement="GW_MergeToRateLimit" isMarkerVisible="true">
        <dc:Bounds x="1330" y="335" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1305" y="310" width="100" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Step6_RateLimitCheck_di" bpmnElement="Task_Step6_RateLimitCheck">
        <dc:Bounds x="1410" y="320" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW7_RateDecision_di" bpmnElement="GW7_RateDecision" isMarkerVisible="true">
        <dc:Bounds x="1570" y="335" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1545" y="310" width="100" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW9_DispatchState_di" bpmnElement="GW9_DispatchState" isMarkerVisible="true">
        <dc:Bounds x="3680" y="335" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3655" y="310" width="100" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_NotifyCaller_di" bpmnElement="Event_NotifyCaller">
        <dc:Bounds x="3590" y="342" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3560" y="383" width="100" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_QueueTimer_di" bpmnElement="Event_QueueTimer">
        <dc:Bounds x="1670" y="150" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1640" y="191" width="100" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_EscalateCriticalLimit_di" bpmnElement="Event_EscalateCriticalLimit">
        <dc:Bounds x="1670" y="230" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1640" y="271" width="100" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_MalformedRequest_di" bpmnElement="EndEvent_MalformedRequest">
