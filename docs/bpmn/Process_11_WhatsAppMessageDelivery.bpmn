        <dc:Bounds x="210" y="320" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW1_Valid_di" bpmnElement="GW1_Valid" isMarkerVisible="true">
        <dc:Bounds x="370" y="335" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="345" y="310" width="100" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW2_Duplicate_di" bpmnElement="GW2_Duplicate" isMarkerVisible="true">
