<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_HogaanOnboarding" targetNamespace="http://hogaan.app/processes" exporter="Hogaan Process Specification" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:message id="Message_InboundMsg" name="InboundMessageFromUnknownNumber" />
  <bpmn:message id="Message_WebSignup" name="WebSignupSubmitted" />
  <bpmn:message id="Message_OptOut" name="OptOutKeywordDetected" />
  <bpmn:message id="Message_UserReply" name="UserReply" />
  <bpmn:signal id="Signal_OnboardingCompleted" name="OnboardingCompleted" />
  <bpmn:error id="Error_Service" name="ServiceError" errorCode="500" />
  <bpmn:collaboration id="Collaboration_Hogaan_Onboarding">
    <bpmn:documentation>Collaboration scope for the User Onboarding process. Single pool ('Hogaan Coaching Platform') containing all five lanes that participate in this process: WhatsApp Gateway, Orchestration Engine, LLM Service, Data Layer, External Services. This is the most lane-heavy of all six core processes — onboarding touches every system.</bpmn:documentation>
    <bpmn:participant id="Participant_Hogaan" name="Hogaan Coaching Platform" processRef="Process_UserOnboarding" />
  </bpmn:collaboration>
  <bpmn:process id="Process_UserOnboarding" name="Hogaan User Onboarding Process" isExecutable="false">
    <bpmn:documentation>Hogaan User Onboarding Process. Runs the first time a phone number contacts the Hogaan WhatsApp number, OR when a user signs up via the lightweight web landing page. Produces a complete user profile and hands off to the Coaching Conversation Process (#2) via the OnboardingCompleted signal.

DESIGN PRINCIPLES:
- Every step is resilient to multi-day user response delays (4h nudge / 48h second nudge / 7d dormant timer on every receive task)
- The flow is resumable: if a user drops off, returning later picks up from the last completed step rather than restarting
- The process is opt-out compliant via a global event subprocess that listens for STOP keywords at any point
- Every user-facing message follows Hamse's voice (asset-based, useful-to-society anchor, story-grounded)
- The whole flow targets 2-3 minutes of total interaction time when the user responds promptly

OWNERSHIP: WhatsApp Gateway sends and receives all user-facing messages. Orchestration Engine runs decision logic, evaluation tasks, and the resume routing. LLM Service generates the personalized confirmation message. Data Layer holds user identity and persists the profile. External Services handles incident routing for unrecoverable failures.

ENGINE TARGET: This artifact is a SPECIFICATION not a deployment. isExecutable=false. Use as the source-of-truth functional spec for service implementation.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Onboarding">
      <bpmn:lane id="Lane_WhatsAppGateway" name="WhatsApp Gateway">
        <bpmn:documentation>WhatsApp Gateway. Hosts every task that sends or receives WhatsApp messages: send tasks (welcome, consent request, goal/role/location prompts, confirmation, first coaching prompt, nudges) and receive tasks (waiting for user replies). Implementation: WhatsApp Business API client (Twilio or Meta Cloud API). All tasks here delegate to Process #11 (WhatsApp Message Delivery) for the actual API call; this lane represents the orchestration boundary at which messages cross into and out of WhatsApp.</bpmn:documentation>
        <bpmn:flowNodeRef>StartEvent_WhatsApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WelcomeBack_Duplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step2_Welcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step3_ConsentSend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step3_ConsentRecv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step4_GoalSend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step4_GoalRecv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step5_RoleSend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step5_RoleRecv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step6_LocSend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step6_LocRecv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step8_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step9_FirstPrompt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Nudge4h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Nudge48h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_DuplicateNumber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Nudge4h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Nudge48h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Error_WA_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_4h_S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_48h_S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_7d_S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_4h_S4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_48h_S4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_7d_S4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_4h_S5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_48h_S5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_7d_S5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_4h_S6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_48h_S6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_7d_S6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OrchestrationEngine" name="Orchestration Engine">
        <bpmn:documentation>Orchestration Engine. Hosts the process control flow: gateways, evaluation tasks (parsing user replies, mapping goals to practices), the resume router, the global opt-out event subprocess, and final routing to end events. Implementation: state machine in the application backend. All decision logic lives here.</bpmn:documentation>
        <bpmn:flowNodeRef>StartEvent_Web</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_IdentityStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ResumeRouter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step3_Eval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ConsentResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step4_Eval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_GoalResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step5_Eval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_RoleResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step6_Eval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step8_QA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_FinalRouting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ConsentDeclined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CompletedFirstTry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CompletedResume</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Degraded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Dormant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_DormantMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ErrorMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_OptOut</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LLMService" name="LLM Service">
        <bpmn:documentation>LLM Service. Hosts every task that calls a large language model. For onboarding, this is just the personalized confirmation message generation in Step 8. Implementation: Anthropic API client with prompt templates managed by Process #17 (Prompt &amp; Content Management).</bpmn:documentation>
        <bpmn:flowNodeRef>Task_Step8_ConfirmationMsg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Error_LLM_S8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DataLayer" name="Data Layer">
        <bpmn:documentation>Data Layer. Hosts every task that reads from or writes to persistent user storage: identity resolution (Step 1) and profile persistence (Step 7). Implementation: Postgres or document store. The user record schema is shared with Process #12 (User Authentication &amp; Identity).</bpmn:documentation>
        <bpmn:flowNodeRef>Task_Step1_IdentityResolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Step7_Persistence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Error_DB_S7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ExternalServices" name="External Services">
        <bpmn:documentation>External Services. Hosts call activities to external systems. For onboarding, this is the Incident Handling subprocess invoked when unrecoverable service failures occur (WhatsApp API down, LLM down, database write fails after retries).</bpmn:documentation>
        <bpmn:flowNodeRef>Task_IncidentHandling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ServiceError</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataObject id="DataObject_UserProfile" name="UserProfile" />
    <bpmn:dataObjectReference id="Ref_UserProfile" name="UserProfile" dataObjectRef="DataObject_UserProfile">
      <bpmn:documentation>UserProfile — the accumulating user record being built across the onboarding flow. Fields: phoneNumber (E.164), userId (UUID), status (onboarding_started | onboarded | consent_declined | onboarding_dormant | opted_out | onboarding_error | needs_profile_review), goals (array, mapped to 12 Practices), role (Student | Professional | Leader), location (optional), timezone (inferred), mappedPractices, lastCompletedStep (int, used for resume), createdAt, completedAt.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="DataObject_OnboardingState" name="OnboardingState" />
    <bpmn:dataObjectReference id="Ref_OnboardingState" name="OnboardingState" dataObjectRef="DataObject_OnboardingState">
      <bpmn:documentation>OnboardingState — process-local state for retry counters and step tracking. Fields: retryCount (per receive task), nudgesSent (4h, 48h flags per receive task), needs_profile_review (true if a clarification loop hit max retries), isResumed (true if this run picked up from a prior incomplete onboarding).</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="DataObject_ConsentRecord" name="ConsentRecord" />
    <bpmn:dataObjectReference id="Ref_ConsentRecord" name="ConsentRecord" dataObjectRef="DataObject_ConsentRecord">
      <bpmn:documentation>ConsentRecord — the consent the user granted at Step 3. Fields: aiCoachingDisclosure (boolean + timestamp), dataHandlingConsent (boolean + timestamp), whatsappMessagingConsent (boolean + timestamp), userResponseRaw (the actual message text). Stored permanently for compliance audit.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="DataObject_ResponseInput" name="ResponseInput" />
    <bpmn:dataObjectReference id="Ref_ResponseInput" name="ResponseInput" dataObjectRef="DataObject_ResponseInput">
      <bpmn:documentation>ResponseInput — the latest user reply being parsed by an evaluation task. Transient, replaced each turn. Fields: messageText, receivedAt, messageId, parsedSelection (if structured), parseError (if any).</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:startEvent id="StartEvent_WhatsApp" name="Inbound WhatsApp Message">
      <bpmn:documentation>Process trigger via inbound WhatsApp message from a phone number not currently in the user store (or in onboarding_started/dormant state).

EVENT TYPE: Message start event. Triggered by the WhatsApp Gateway when a webhook receives a message from an unrecognized number.

PAYLOAD: phoneNumber (E.164), inboundMessageText, inboundMessageId, timestamp, mediaReference (if any — onboarding ignores media for MVP).</bpmn:documentation>
      <bpmn:outgoing>Flow_StartWA_To_ID</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_InboundWA" messageRef="Message_InboundMsg" />
    </bpmn:startEvent>
    <bpmn:startEvent id="StartEvent_Web" name="Web Signup Submitted">
      <bpmn:documentation>Process trigger via web landing page signup form submission.

EVENT TYPE: Message start event. Triggered when the web frontend POSTs the signup form (phone number entered).

PAYLOAD: phoneNumber (E.164), originatingIp, userAgent, timestamp.

DIFFERENCE FROM WHATSAPP TRIGGER: Web signup means the user has NOT yet sent a WhatsApp message. Step 2 (Welcome) must initiate outbound contact via WhatsApp Gateway, which requires the user's phone number to be added to the messaging permission list at WhatsApp.</bpmn:documentation>
      <bpmn:outgoing>Flow_StartWeb_To_ID</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_WebSignup" messageRef="Message_WebSignup" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Step1_IdentityResolution" name="Step 1: Identity Resolution">
      <bpmn:documentation>Step 1 — Identity Resolution.

PURPOSE: Look up the phone number in the user store and determine the routing for this onboarding attempt.

LOGIC:
- Normalize phone number to E.164
- Query user record by phone number
- If record found AND status == 'onboarded': this is a duplicate signup → set status flag for routing
- If record found AND status in [onboarding_started, onboarding_dormant]: this is a resume → load lastCompletedStep
- If record not found: this is a new user → create provisional record with status=onboarding_started, lastCompletedStep=0, isNew=true

OUTPUT: profile.status, profile.lastCompletedStep, profile.isNew flag set in process state.

IMPLEMENTATION HINT: Service task with database read + conditional write. See Process #12 (User Authentication &amp; Identity) for the canonical identity resolution logic — this task delegates to that process or duplicates its lookup logic. The resume detection is critical: misclassifying a returning user as new will overwrite their prior progress.</bpmn:documentation>
      <bpmn:incoming>Flow_StartWA_To_ID</bpmn:incoming>
      <bpmn:incoming>Flow_StartWeb_To_ID</bpmn:incoming>
      <bpmn:outgoing>Flow_ID_To_GWStatus</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_IdentityStatus" name="User Status?">
      <bpmn:documentation>Routes based on identity resolution outcome.

DECISION LOGIC (plain English):
- DUPLICATE branch: profile.status == 'onboarded' (user already completed onboarding previously) → route to Welcome Back message and terminate
- ONBOARDING branch: profile.status == 'onboarding_started' OR profile.isNew == true → route to Resume Router to determine which step to start at</bpmn:documentation>
      <bpmn:incoming>Flow_ID_To_GWStatus</bpmn:incoming>
      <bpmn:outgoing>Flow_Status_Duplicate</bpmn:outgoing>
      <bpmn:outgoing>Flow_Status_Onboarding</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_WelcomeBack_Duplicate" name="Send Welcome Back Message">
      <bpmn:documentation>Sends a brief 'Welcome back' message to the user via WhatsApp, with guidance to either continue chatting (which will route them to Process #2 Coaching) or update their profile.

MESSAGE CONTENT (Hamse voice): 'Welcome back. Glad you're here again. Just send me what's on your mind and we'll pick up from there.'

IMPLEMENTATION HINT: Send task. Delegates to Process #11 (WhatsApp Message Delivery) for actual API call. After sending, the user's next inbound message will be handled by Process #2 (which checks identity via Process #12 and routes to coaching).</bpmn:documentation>
      <bpmn:incoming>Flow_Status_Duplicate</bpmn:incoming>
      <bpmn:outgoing>Flow_Dup_To_E8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_DuplicateNumber" name="E8: Duplicate Number">
      <bpmn:documentation>E8: DuplicateNumber end event. Reached when an already-onboarded user attempts a new signup. Welcome Back message has been sent. The user's subsequent message will be handled by Process #2 (Coaching).</bpmn:documentation>
      <bpmn:incoming>Flow_Dup_To_E8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_ResumeRouter" name="Resume Router (Last Completed Step?)">
      <bpmn:documentation>6-way exclusive gateway that routes to the correct step based on the user's lastCompletedStep value. This is the heart of the resume capability.

DECISION LOGIC (plain English):
- lastCompletedStep == 0 (new user, nothing done yet): route to Step 2 (Welcome message)
- lastCompletedStep == 2 (welcome sent, no consent yet): route to Step 3 (Consent request)
- lastCompletedStep == 3 (consent given, no goal yet): route to Step 4 (Goal selection)
- lastCompletedStep == 4 (goal captured, no role yet): route to Step 5 (Role selection)
- lastCompletedStep == 5 (role captured, location not asked yet): route to Step 6 (Location)
- lastCompletedStep == 6 (location captured, profile not persisted): route to Step 7 (Persistence)

NOTE: lastCompletedStep == 1 is unused (Step 1 is identity resolution itself; reaching this gateway means it's already done). lastCompletedStep == 7 means onboarding is complete and the user shouldn't be in this gateway — the upstream identity check handles that case.</bpmn:documentation>
      <bpmn:incoming>Flow_Status_Onboarding</bpmn:incoming>
      <bpmn:outgoing>Flow_Resume_S2</bpmn:outgoing>
      <bpmn:outgoing>Flow_Resume_S3</bpmn:outgoing>
      <bpmn:outgoing>Flow_Resume_S4</bpmn:outgoing>
      <bpmn:outgoing>Flow_Resume_S5</bpmn:outgoing>
      <bpmn:outgoing>Flow_Resume_S6</bpmn:outgoing>
      <bpmn:outgoing>Flow_Resume_S7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Task_Step2_Welcome" name="Step 2: Welcome Message">
      <bpmn:documentation>Step 2 — Welcome Message.

PURPOSE: Send the introductory welcome message via WhatsApp, in Hamse's voice, with the 'be useful to society' anchor.

MESSAGE CONTENT (Hamse voice): 'Welcome to Hogaan. My name is your leadership companion — built on the work of Hamse Warfa. I'll ask you a few quick questions, then we begin. The goal is simple: to be useful to you, so you can be useful to others.'

IMPLEMENTATION HINT: Call activity invoking Process #11 (WhatsApp Message Delivery). On success, advances lastCompletedStep to 2 and proceeds to Step 3.

ERROR BOUNDARY: WhatsApp API failure routes via Error_WA_S2 to incident handling.</bpmn:documentation>
      <bpmn:incoming>Flow_Resume_S2</bpmn:incoming>
      <bpmn:outgoing>Flow_S2_To_S3Send</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sendTask id="Task_Step3_ConsentSend" name="Step 3: Send Consent Request">
      <bpmn:documentation>Step 3 (Send) — Consent Request.

PURPOSE: Ask for explicit consent on three things in a single message: AI coaching disclosure, data handling, WhatsApp messaging consent.

MESSAGE CONTENT: 'Before we begin, three quick things to be transparent: (1) You're talking to an AI built on Hamse Warfa's leadership framework — not Hamse himself. (2) Our conversations are private; nothing you share is used to train external AI models. (3) I'll send messages to this number from time to time — you can stop anytime by replying STOP. Reply YES to continue, or anything else to opt out.'

IMPLEMENTATION HINT: Send task delegating to WhatsApp Gateway. After send, control passes to the paired receive task to await user reply.</bpmn:documentation>
      <bpmn:incoming>Flow_Resume_S3</bpmn:incoming>
      <bpmn:incoming>Flow_S2_To_S3Send</bpmn:incoming>
      <bpmn:outgoing>Flow_S3Send_To_S3Recv</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_Step3_ConsentRecv" name="Wait for Consent Reply">
      <bpmn:documentation>Step 3 (Receive) — Wait for Consent Reply.

PURPOSE: Wait for the user's response to the consent request. Three timer boundary events attach to this task: 4h nudge (non-interrupting), 48h second nudge (non-interrupting), 7d dormant (interrupting).

EXPECTED RESPONSE: Affirmative keyword (yes / sow / agree / I agree / accept / OK) OR negative/ambiguous response.

IMPLEMENTATION HINT: Receive task waiting on Message_UserReply correlated by phoneNumber. Timer boundary events ensure the process doesn't sit indefinitely if the user never responds.</bpmn:documentation>
      <bpmn:incoming>Flow_S3Send_To_S3Recv</bpmn:incoming>
      <bpmn:outgoing>Flow_S3Recv_To_S3Eval</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:businessRuleTask id="Task_Step3_Eval" name="Evaluate Consent Response">
      <bpmn:documentation>Step 3 (Eval) — Evaluate Consent Response.

PURPOSE: Parse the user's reply and determine if all three consents were granted.

LOGIC: Affirmative keyword detection (case-insensitive); fuzzy matching for common variants (yes, ya, sure, agree, accept, ok). Negative or ambiguous responses are treated as decline.

OUTPUT: consentGiven (boolean), consentRecord populated with timestamps and raw response text.

IMPLEMENTATION HINT: Business rule task. The keyword catalog is maintained by Process #17.</bpmn:documentation>
      <bpmn:incoming>Flow_S3Recv_To_S3Eval</bpmn:incoming>
      <bpmn:outgoing>Flow_S3Eval_To_GW</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW_ConsentResult" name="Consent Granted?">
      <bpmn:documentation>Routes based on consent evaluation.

DECISION LOGIC (plain English):
- YES branch: consentGiven == true → proceed to Step 4 (Goal Selection)
- NO branch: consentGiven == false → terminate at EndEvent_ConsentDeclined; user is added to suppression list</bpmn:documentation>
      <bpmn:incoming>Flow_S3Eval_To_GW</bpmn:incoming>
      <bpmn:outgoing>Flow_Consent_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_Consent_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_ConsentDeclined" name="E3: Consent Declined">
      <bpmn:documentation>E3: ConsentDeclined end event. Reached when the user replied with anything other than affirmative consent at Step 3. Profile status set to 'consent_declined'. Phone number added to suppression list. No further messages will be sent. Compliance log entry written.</bpmn:documentation>
      <bpmn:incoming>Flow_Consent_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_Step4_GoalSend" name="Step 4: Send Goal Selection Prompt">
      <bpmn:documentation>Step 4 (Send) — Goal Selection Prompt.

PURPOSE: Ask the user what they want to grow in.

MESSAGE CONTENT: 'What do you want to grow in? Reply with the number(s):
1. Leadership confidence
2. Communication
3. Conflict resolution
4. Career growth

You can pick more than one (e.g., 1,3).'

IMPLEMENTATION HINT: Send task. WhatsApp doesn't render rich buttons reliably across all client versions, so use numbered text format. Multi-select is supported via comma-separated reply. This task can be re-entered up to 2 times if the user replies in an unparseable format.</bpmn:documentation>
      <bpmn:incoming>Flow_Resume_S4</bpmn:incoming>
      <bpmn:incoming>Flow_Consent_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_S4_Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_S4Send_To_S4Recv</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_Step4_GoalRecv" name="Wait for Goal Reply">
      <bpmn:documentation>Step 4 (Receive) — Wait for Goal Reply. Same timer boundary pattern as Step 3.</bpmn:documentation>
      <bpmn:incoming>Flow_S4Send_To_S4Recv</bpmn:incoming>
      <bpmn:outgoing>Flow_S4Recv_To_S4Eval</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:businessRuleTask id="Task_Step4_Eval" name="Parse Goals and Map to Practices">
      <bpmn:documentation>Step 4 (Eval) — Parse Goals and Map to Practices.

PURPOSE: Parse the user's reply (numbered selection, possibly multi-select) and map each selected goal to one or more of Hamse's 12 Practices.

GOAL → PRACTICE MAPPING:
- Leadership confidence → Integrity, Purpose, Accountability (Self level)
- Communication → Dignity, Empathy (Team level)
- Conflict resolution → Empathy, Peace (Team + Community)
- Career growth → Purpose, Assets, Innovation (Self + Org)

LOGIC: Parse comma-separated or natural-language reply. Map each numeric to its goal name and corresponding practices. If parse fails, increment retryCount; if retryCount &lt; 2, retry; if retryCount &gt;= 2, default to 'Leadership confidence' and flag profile.needs_profile_review = true.

OUTPUT: profile.goals (array), profile.mappedPractices (array of 12 Practice names), isValid (boolean), retryCount.

IMPLEMENTATION HINT: Business rule task with parsing logic. The mapping catalog is maintained by Process #17.</bpmn:documentation>
      <bpmn:incoming>Flow_S4Recv_To_S4Eval</bpmn:incoming>
      <bpmn:outgoing>Flow_S4Eval_To_GW</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW_GoalResult" name="Valid or Max Retries?">
      <bpmn:documentation>Routes based on goal parse result.

DECISION LOGIC (plain English):
- PASS branch: isValid == true OR retryCount &gt;= 2 (max retries reached) → proceed to Step 5
- RETRY branch: isValid == false AND retryCount &lt; 2 → re-send Step 4 prompt (with clarification)</bpmn:documentation>
      <bpmn:incoming>Flow_S4Eval_To_GW</bpmn:incoming>
      <bpmn:outgoing>Flow_S4_Retry</bpmn:outgoing>
      <bpmn:outgoing>Flow_S4_Pass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Step5_RoleSend" name="Step 5: Send Role Selection Prompt">
      <bpmn:documentation>Step 5 (Send) — Role Selection Prompt.

PURPOSE: Ask which best describes the user.

MESSAGE CONTENT: 'Which best describes you? Reply with the number:
1. Student
2. Professional
3. Leader (manager, founder, executive, community leader)'

IMPLEMENTATION HINT: Send task. Single-select (unlike goals). Same retry logic as Step 4.</bpmn:documentation>
      <bpmn:incoming>Flow_Resume_S5</bpmn:incoming>
      <bpmn:incoming>Flow_S4_Pass</bpmn:incoming>
      <bpmn:incoming>Flow_S5_Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_S5Send_To_S5Recv</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_Step5_RoleRecv" name="Wait for Role Reply">
      <bpmn:documentation>Step 5 (Receive) — Wait for Role Reply. Same timer boundary pattern as Step 3.</bpmn:documentation>
      <bpmn:incoming>Flow_S5Send_To_S5Recv</bpmn:incoming>
      <bpmn:outgoing>Flow_S5Recv_To_S5Eval</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:businessRuleTask id="Task_Step5_Eval" name="Parse Role Selection">
      <bpmn:documentation>Step 5 (Eval) — Parse Role Selection.

PURPOSE: Parse the user's reply (single number or natural-language role description).

LOGIC: Match reply to one of three role categories. If parse fails, increment retryCount; if retryCount &gt;= 2, default to 'Professional' and flag profile.needs_profile_review = true.

OUTPUT: profile.role, isValid, retryCount.

IMPLEMENTATION HINT: Business rule task.</bpmn:documentation>
      <bpmn:incoming>Flow_S5Recv_To_S5Eval</bpmn:incoming>
      <bpmn:outgoing>Flow_S5Eval_To_GW</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW_RoleResult" name="Valid or Max Retries?">
      <bpmn:documentation>Routes based on role parse result.

DECISION LOGIC (plain English):
- PASS branch: isValid == true OR retryCount &gt;= 2 → proceed to Step 6
- RETRY branch: isValid == false AND retryCount &lt; 2 → re-send Step 5 prompt</bpmn:documentation>
      <bpmn:incoming>Flow_S5Eval_To_GW</bpmn:incoming>
      <bpmn:outgoing>Flow_S5_Retry</bpmn:outgoing>
      <bpmn:outgoing>Flow_S5_Pass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Step6_LocSend" name="Step 6: Send Location Prompt">
      <bpmn:documentation>Step 6 (Send) — Optional Location Capture.

PURPOSE: Capture the user's city/country for timezone inference and cultural framing context. Optional — user can skip.

MESSAGE CONTENT: 'Where are you based? Just a city or country is enough — this helps me know when to message you and gives me useful context. Reply 'skip' if you'd rather not.'

IMPLEMENTATION HINT: Send task. Free-text response (not numbered). 'skip' keyword bypasses location storage. No retry logic — invalid responses are treated as freeform location strings.</bpmn:documentation>
      <bpmn:incoming>Flow_Resume_S6</bpmn:incoming>
      <bpmn:incoming>Flow_S5_Pass</bpmn:incoming>
      <bpmn:outgoing>Flow_S6Send_To_S6Recv</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_Step6_LocRecv" name="Wait for Location Reply">
      <bpmn:documentation>Step 6 (Receive) — Wait for Location Reply. Same timer boundary pattern as Step 3.</bpmn:documentation>
      <bpmn:incoming>Flow_S6Send_To_S6Recv</bpmn:incoming>
      <bpmn:outgoing>Flow_S6Recv_To_S6Eval</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:scriptTask id="Task_Step6_Eval" name="Infer Timezone &#38; Diaspora Flag">
      <bpmn:documentation>Step 6 (Eval) — Infer Timezone and Diaspora/Home Flag.

PURPOSE: Process the location reply: detect 'skip' keyword, otherwise attempt to parse city/country and infer timezone. Also infer diaspora-vs-home flag for the cultural framing layer.

LOGIC:
- If reply is 'skip' (case-insensitive): set profile.location = null, profile.timezone = UTC default
- Otherwise: store raw location string; attempt timezone inference via geocoding service; flag diaspora=true if location is outside Somalia/Horn of Africa, diaspora=false if inside

OUTPUT: profile.location, profile.timezone, profile.isDiaspora.

IMPLEMENTATION HINT: Script task with optional geocoding service call. Geocoding failure is non-fatal — falls back to UTC and unset diaspora flag. No retry on this step (invalid input is silently accepted as freeform).</bpmn:documentation>
      <bpmn:incoming>Flow_S6Recv_To_S6Eval</bpmn:incoming>
      <bpmn:outgoing>Flow_S6_Pass</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Task_Step7_Persistence" name="Step 7: Persist Profile">
      <bpmn:documentation>Step 7 — Profile Persistence.

PURPOSE: Write the assembled profile to the user store with status='onboarded'. This is the commitment point — after this task succeeds, the user is officially onboarded.

LOGIC: Idempotent database write keyed on userId/phoneNumber. Updates status from 'onboarding_started' to 'onboarded'. Sets completedAt timestamp. Persists all fields collected in steps 4-6.

OUTPUT: profile.status = 'onboarded', profile.completedAt set.

IMPLEMENTATION HINT: Service task with database write. Must be idempotent (use unique constraint on phoneNumber + transactional upsert).

ERROR BOUNDARY: Database failure routes via Error_DB_S7 to incident handling. The profile may be partially written; the incident handler is responsible for cleanup or retry.</bpmn:documentation>
      <bpmn:incoming>Flow_Resume_S7</bpmn:incoming>
      <bpmn:incoming>Flow_S6_Pass</bpmn:incoming>
      <bpmn:outgoing>Flow_S7_To_S8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Step8_ConfirmationMsg" name="Step 8: Generate Personalized Confirmation">
      <bpmn:documentation>Step 8 (Generate) — Personalized Confirmation Message via LLM.

PURPOSE: Generate a confirmation message that reflects what the user told you back to them, in Hamse's voice, asset-based and warm.

EXAMPLE OUTPUT: 'Got it — you're focused on leadership confidence and you're leading a team. That's the kind of work that shapes a life. Let's get into it.'

LOGIC: LLM call with onboarding-confirmation prompt template, populated with profile.goals, profile.role, profile.location. Output must follow Hamse's voice rules.

IMPLEMENTATION HINT: Service task calling Anthropic API. The prompt template is maintained by Process #17. Output passes through Process #10 (Response Quality Check) before delivery.

ERROR BOUNDARY: LLM failure routes via Error_LLM_S8 to incident handling. Optional fallback: use a templated (non-LLM) confirmation message; this is the right trade-off for onboarding because the user is mid-flow and we shouldn't terminate over a one-off LLM failure.</bpmn:documentation>
      <bpmn:incoming>Flow_S7_To_S8</bpmn:incoming>
      <bpmn:outgoing>Flow_S8_To_S8QA</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="Task_Step8_QA" name="Run RQC on Confirmation">
      <bpmn:documentation>Step 8 (QA) — Run Confirmation Through Response Quality Check.

PURPOSE: Validate the LLM-generated confirmation against Hogaan's brand and safety standards before delivery.

IMPLEMENTATION HINT: Call activity invoking Process #10 (Response Quality Check). On approval, proceed to send. On regeneration loop exhaustion, the call activity returns a fallback response which is delivered instead.</bpmn:documentation>
      <bpmn:incoming>Flow_S8_To_S8QA</bpmn:incoming>
      <bpmn:outgoing>Flow_S8QA_To_S8Send</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sendTask id="Task_Step8_Send" name="Step 8: Send Confirmation">
      <bpmn:documentation>Step 8 (Send) — Deliver the approved confirmation message via WhatsApp Gateway.</bpmn:documentation>
      <bpmn:incoming>Flow_S8QA_To_S8Send</bpmn:incoming>
      <bpmn:outgoing>Flow_S8_To_S9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_Step9_FirstPrompt" name="Step 9: Send First Coaching Prompt">
      <bpmn:documentation>Step 9 — First Coaching Prompt.

PURPOSE: Send the opening coaching question that hands off to Process #2 (Coaching Conversation).

MESSAGE CONTENT: 'Welcome. Let's begin. Tell me — what is one leadership challenge you're facing right now?'

LOGIC: Send via WhatsApp Gateway. After send, emit OnboardingCompleted signal. Subsequent user replies are handled by Process #2 (which subscribes to this signal AND processes any new inbound message from this user).

IMPLEMENTATION HINT: Send task. The signal is emitted from the End Event, not this task — so this task's job is purely to send and advance.</bpmn:documentation>
      <bpmn:incoming>Flow_S8_To_S9</bpmn:incoming>
      <bpmn:outgoing>Flow_S9_To_GWFinal</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="GW_FinalRouting" name="Profile State?">
      <bpmn:documentation>Final routing gateway distinguishing three terminal happy-path states.

DECISION LOGIC (plain English):
- DEGRADED branch: profile.needs_profile_review == true → terminate at EndEvent_Degraded (E7); profile is created with default values for unanswered questions but flagged for human review
- RESUMED branch: profile.needs_profile_review == false AND profile.isResumed == true → terminate at EndEvent_CompletedResume (E2); user picked up from a prior attempt and finished
- NORMAL branch: profile.needs_profile_review == false AND profile.isResumed == false → terminate at EndEvent_CompletedFirstTry (E1); user completed in one go (~60% of starts in week 1)</bpmn:documentation>
      <bpmn:incoming>Flow_S9_To_GWFinal</bpmn:incoming>
      <bpmn:outgoing>Flow_Final_Normal</bpmn:outgoing>
      <bpmn:outgoing>Flow_Final_Resumed</bpmn:outgoing>
      <bpmn:outgoing>Flow_Final_Degraded</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_CompletedFirstTry" name="E1: Onboarding Completed">
      <bpmn:documentation>E1: OnboardingCompleted end event (first-try variant). Reached when a user completes the entire flow in one continuous session. Emits OnboardingCompleted signal that Process #2 subscribes to. Profile status: 'onboarded'. Target state: ~60% of starts in week 1.</bpmn:documentation>
      <bpmn:incoming>Flow_Final_Normal</bpmn:incoming>
      <bpmn:signalEventDefinition id="SigDef_E1" signalRef="Signal_OnboardingCompleted" />
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_CompletedResume" name="E2: Completed After Resume">
      <bpmn:documentation>E2: OnboardingCompletedAfterResume end event. Reached when a user dropped off mid-flow, returned days later, resumed from a checkpoint, and completed. Emits OnboardingCompleted signal. Profile status: 'onboarded' with isResumed=true flag. Target state: ~15% of starts.</bpmn:documentation>
      <bpmn:incoming>Flow_Final_Resumed</bpmn:incoming>
      <bpmn:signalEventDefinition id="SigDef_E2" signalRef="Signal_OnboardingCompleted" />
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Degraded" name="E7: Clarification Loop Exceeded">
      <bpmn:documentation>E7: ClarificationLoopExceeded end event. Reached when the user gave 3+ unparseable responses to a single question, the system applied default values, and onboarding completed in a degraded state. Profile is functional but flagged with needs_profile_review=true. Emits OnboardingCompleted signal so coaching can begin; the user can refine their profile later.</bpmn:documentation>
      <bpmn:incoming>Flow_Final_Degraded</bpmn:incoming>
      <bpmn:signalEventDefinition id="SigDef_E7" signalRef="Signal_OnboardingCompleted" />
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_Nudge4h" name="Send 4-Hour Nudge">
      <bpmn:documentation>Sends the 4-hour gentle nudge message to the user. Single shared task that all four 4h timer boundary events route to.

MESSAGE CONTENT: 'Still here whenever you're ready — just reply when you have a minute.'

IMPLEMENTATION HINT: Send task delegating to WhatsApp Gateway. The specific receive task that triggered this nudge is identified by sessionId and stored for analytics. The nudge does not affect the parent receive task; it just provides a friendly check-in.</bpmn:documentation>
      <bpmn:incoming>Flow_T4_S3</bpmn:incoming>
      <bpmn:incoming>Flow_T4_S4</bpmn:incoming>
      <bpmn:incoming>Flow_T4_S5</bpmn:incoming>
      <bpmn:incoming>Flow_T4_S6</bpmn:incoming>
      <bpmn:outgoing>Flow_N4_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_Nudge4h" name="Nudge Branch Ends (4h)">
      <bpmn:documentation>Terminates the 4-hour nudge sub-flow. Note: this is not a main process end event (the main flow continues at the parent receive task); it's the end of the parallel nudge branch.</bpmn:documentation>
      <bpmn:incoming>Flow_N4_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_Nudge48h" name="Send 48-Hour Nudge">
      <bpmn:documentation>Sends the 48-hour second nudge with a re-engagement hook.

MESSAGE CONTENT: 'Picking up where we left off — [restate the question briefly]. Reply when you can.'

IMPLEMENTATION HINT: Send task. The 'restate the question briefly' content is parameterized based on which step the user is stuck on (consent / goal / role / location). The catalog of nudge variants is maintained by Process #17.</bpmn:documentation>
      <bpmn:incoming>Flow_T48_S3</bpmn:incoming>
      <bpmn:incoming>Flow_T48_S4</bpmn:incoming>
      <bpmn:incoming>Flow_T48_S5</bpmn:incoming>
      <bpmn:incoming>Flow_T48_S6</bpmn:incoming>
      <bpmn:outgoing>Flow_N48_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_Nudge48h" name="Nudge Branch Ends (48h)">
      <bpmn:documentation>Terminates the 48-hour nudge sub-flow.</bpmn:documentation>
      <bpmn:incoming>Flow_N48_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_DormantMerge" name="Dormant Merge">
      <bpmn:documentation>Convergence point for all four 7-day dormant timers. Routes to EndEvent_Dormant.</bpmn:documentation>
      <bpmn:incoming>Flow_T7_S3</bpmn:incoming>
      <bpmn:incoming>Flow_T7_S4</bpmn:incoming>
      <bpmn:incoming>Flow_T7_S5</bpmn:incoming>
      <bpmn:incoming>Flow_T7_S6</bpmn:incoming>
      <bpmn:outgoing>Flow_To_E4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Dormant" name="E4: Onboarding Dormant">
      <bpmn:documentation>E4: OnboardingDormant end event. Reached when the 7-day timer fires on any receive task without the user responding. Profile status: 'onboarding_dormant'. The user can resume by sending any new message — that triggers a fresh entry to this process at Step 1, which detects the dormant state and routes to Resume Router.</bpmn:documentation>
      <bpmn:incoming>Flow_To_E4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_ErrorMerge" name="Error Merge">
      <bpmn:documentation>Convergence point for all three error boundary events (S2, S7, S8). Routes to Incident Handling.</bpmn:documentation>
      <bpmn:incoming>Flow_Err_S2</bpmn:incoming>
      <bpmn:incoming>Flow_Err_S7</bpmn:incoming>
      <bpmn:incoming>Flow_Err_S8</bpmn:incoming>
      <bpmn:outgoing>Flow_GWError_To_Incident</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Task_IncidentHandling" name="Incident Handling">
      <bpmn:documentation>Call activity invoking Process #18 (Incident Handling). Logs the failure, marks the user profile with status='onboarding_error', and triggers an engineering alert.

IMPLEMENTATION HINT: Defined as separate process. The error context (which step failed, error code, retry history) is passed in.</bpmn:documentation>
      <bpmn:incoming>Flow_GWError_To_Incident</bpmn:incoming>
      <bpmn:outgoing>Flow_Incident_To_E6</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="EndEvent_ServiceError" name="E6: Service Unavailable">
      <bpmn:documentation>E6: ServiceUnavailable end event. Reached after Incident Handling subprocess completes for an unrecoverable service failure. Profile status: 'onboarding_error'. Incident logged at high severity for engineering review.</bpmn:documentation>
      <bpmn:incoming>Flow_Incident_To_E6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Timer_4h_S3" name="4h Nudge Timer" cancelActivity="false" attachedToRef="Task_Step3_ConsentRecv">
      <bpmn:documentation>Non-interrupting 4-hour timer on Consent Receive. Fires once if user hasn't replied within 4 hours of consent request. Routes to Send 4h Nudge task. Does NOT cancel the parent receive task — user can still reply.</bpmn:documentation>
      <bpmn:outgoing>Flow_T4_S3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Timer_4h_S3">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Timer_48h_S3" name="48h Nudge Timer" cancelActivity="false" attachedToRef="Task_Step3_ConsentRecv">
      <bpmn:documentation>Non-interrupting 48-hour timer on Consent Receive. Fires once if user hasn't replied within 48 hours. Routes to Send 48h Nudge task with re-engagement hook. Does NOT cancel the parent receive task.</bpmn:documentation>
      <bpmn:outgoing>Flow_T48_S3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Timer_48h_S3">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Timer_7d_S3" name="7d Dormant Timer" attachedToRef="Task_Step3_ConsentRecv">
      <bpmn:documentation>Interrupting 7-day timer on Consent Receive. Fires if user hasn't replied within 7 days. Cancels parent receive task and routes to Dormant Merge. Profile marked onboarding_dormant.</bpmn:documentation>
      <bpmn:outgoing>Flow_T7_S3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Timer_7d_S3">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Timer_4h_S4" name="4h Nudge Timer" cancelActivity="false" attachedToRef="Task_Step4_GoalRecv">
      <bpmn:documentation>Non-interrupting 4-hour timer on Goal Receive. Same pattern as Timer_4h_S3.</bpmn:documentation>
      <bpmn:outgoing>Flow_T4_S4</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Timer_4h_S4">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Timer_48h_S4" name="48h Nudge Timer" cancelActivity="false" attachedToRef="Task_Step4_GoalRecv">
      <bpmn:documentation>Non-interrupting 48-hour timer on Goal Receive. Same pattern as Timer_48h_S3.</bpmn:documentation>
      <bpmn:outgoing>Flow_T48_S4</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Timer_48h_S4">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Timer_7d_S4" name="7d Dormant Timer" attachedToRef="Task_Step4_GoalRecv">
      <bpmn:documentation>Interrupting 7-day timer on Goal Receive. Same pattern as Timer_7d_S3.</bpmn:documentation>
      <bpmn:outgoing>Flow_T7_S4</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Timer_7d_S4">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Timer_4h_S5" name="4h Nudge Timer" cancelActivity="false" attachedToRef="Task_Step5_RoleRecv">
      <bpmn:documentation>Non-interrupting 4-hour timer on Role Receive.</bpmn:documentation>
      <bpmn:outgoing>Flow_T4_S5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Timer_4h_S5">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Timer_48h_S5" name="48h Nudge Timer" cancelActivity="false" attachedToRef="Task_Step5_RoleRecv">
      <bpmn:documentation>Non-interrupting 48-hour timer on Role Receive.</bpmn:documentation>
      <bpmn:outgoing>Flow_T48_S5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Timer_48h_S5">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Timer_7d_S5" name="7d Dormant Timer" attachedToRef="Task_Step5_RoleRecv">
      <bpmn:documentation>Interrupting 7-day timer on Role Receive.</bpmn:documentation>
      <bpmn:outgoing>Flow_T7_S5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Timer_7d_S5">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Timer_4h_S6" name="4h Nudge Timer" cancelActivity="false" attachedToRef="Task_Step6_LocRecv">
      <bpmn:documentation>Non-interrupting 4-hour timer on Location Receive.</bpmn:documentation>
      <bpmn:outgoing>Flow_T4_S6</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Timer_4h_S6">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Timer_48h_S6" name="48h Nudge Timer" cancelActivity="false" attachedToRef="Task_Step6_LocRecv">
      <bpmn:documentation>Non-interrupting 48-hour timer on Location Receive.</bpmn:documentation>
      <bpmn:outgoing>Flow_T48_S6</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Timer_48h_S6">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Timer_7d_S6" name="7d Dormant Timer" attachedToRef="Task_Step6_LocRecv">
      <bpmn:documentation>Interrupting 7-day timer on Location Receive.</bpmn:documentation>
      <bpmn:outgoing>Flow_T7_S6</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Timer_7d_S6">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Error_WA_S2" name="WhatsApp API Error" attachedToRef="Task_Step2_Welcome">
      <bpmn:documentation>Error boundary event on Step 2 (Welcome). Catches WhatsApp API failure (timeout, rate limit exhausted, account suspension, network error). Routes to GW_ErrorMerge.</bpmn:documentation>
      <bpmn:outgoing>Flow_Err_S2</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_Error_WA_S2" errorRef="Error_Service" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Error_DB_S7" name="Database Error" attachedToRef="Task_Step7_Persistence">
      <bpmn:documentation>Error boundary event on Step 7 (Persistence). Catches database write failure. Routes to GW_ErrorMerge.</bpmn:documentation>
      <bpmn:outgoing>Flow_Err_S7</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_Error_DB_S7" errorRef="Error_Service" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Error_LLM_S8" name="LLM Service Error" attachedToRef="Task_Step8_ConfirmationMsg">
      <bpmn:documentation>Error boundary event on Step 8 (Confirmation Generation). Catches LLM API failure. Routes to GW_ErrorMerge. NOTE: optional improvement is to catch this error and fall back to a templated (non-LLM) confirmation rather than failing onboarding entirely.</bpmn:documentation>
      <bpmn:outgoing>Flow_Err_S8</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_Error_LLM_S8" errorRef="Error_Service" />
    </bpmn:boundaryEvent>
    <bpmn:subProcess id="SubProcess_OptOut" name="Global Opt-Out Handler" triggeredByEvent="true">
      <bpmn:documentation>Global event subprocess that listens for opt-out keywords ('STOP', 'UNSUBSCRIBE', 'LEAVE', 'OPT OUT') at any point in the onboarding flow.

EVENT TYPE: Non-interrupting message event subprocess. Triggered by Message_OptOut, which is emitted by the WhatsApp Gateway when an inbound message matches an opt-out keyword pattern.

WHEN ACTIVE: This subprocess is active throughout the entire onboarding process. If the user sends 'STOP' at any point, this subprocess fires and terminates the main flow.

IMPLEMENTATION HINT: Event subprocess attached at the process scope. The keyword catalog is maintained by Process #17 with regional variants.</bpmn:documentation>
      <bpmn:startEvent id="StartEvent_OptOut" name="Opt-Out Keyword Detected">
        <bpmn:documentation>Start event of the opt-out subprocess. Triggered by Message_OptOut from WhatsApp Gateway when an inbound message matches opt-out keyword.</bpmn:documentation>
        <bpmn:outgoing>Flow_Opt_1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MsgDef_OptOut" messageRef="Message_OptOut" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_OptOutDB" name="Mark Profile Opted Out">
        <bpmn:documentation>Marks the user's profile with status='opted_out' and adds the phone number to the global suppression list maintained by Process #12 (Identity).

IMPLEMENTATION HINT: Service task with database write. MUST succeed — opt-out failures are a compliance liability. Retry on transient failure; on permanent failure, escalate to incident handling.</bpmn:documentation>
        <bpmn:incoming>Flow_Opt_1</bpmn:incoming>
        <bpmn:outgoing>Flow_Opt_2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="Task_OptOutReply" name="Send Opt-Out Confirmation">
        <bpmn:documentation>Sends the WhatsApp opt-out confirmation per platform compliance requirements.

MESSAGE CONTENT: 'You've been unsubscribed. You won't hear from Hogaan again. Take care.'

IMPLEMENTATION HINT: Send task. WhatsApp Business Platform requires this confirmation to be sent within a short window of the opt-out request.</bpmn:documentation>
        <bpmn:incoming>Flow_Opt_2</bpmn:incoming>
        <bpmn:outgoing>Flow_Opt_3</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="EndEvent_Abandoned" name="E5: Onboarding Abandoned">
        <bpmn:documentation>E5: OnboardingAbandoned end event (within event subprocess). Profile status: 'opted_out'. User added to permanent suppression list. No further messages will be sent. Onboarding terminated.</bpmn:documentation>
        <bpmn:incoming>Flow_Opt_3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Opt_1" sourceRef="StartEvent_OptOut" targetRef="Task_OptOutDB">
        <bpmn:documentation>Opt-out trigger fired; mark profile in DB.</bpmn:documentation>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Opt_2" sourceRef="Task_OptOutDB" targetRef="Task_OptOutReply">
        <bpmn:documentation>Profile marked opted_out; send compliance confirmation.</bpmn:documentation>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Opt_3" sourceRef="Task_OptOutReply" targetRef="EndEvent_Abandoned">
        <bpmn:documentation>Confirmation sent; terminate.</bpmn:documentation>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_StartWA_To_ID" sourceRef="StartEvent_WhatsApp" targetRef="Task_Step1_IdentityResolution">
      <bpmn:documentation>WhatsApp inbound trigger; route to identity resolution.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_StartWeb_To_ID" sourceRef="StartEvent_Web" targetRef="Task_Step1_IdentityResolution">
      <bpmn:documentation>Web signup trigger; route to identity resolution.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ID_To_GWStatus" sourceRef="Task_Step1_IdentityResolution" targetRef="GW_IdentityStatus">
      <bpmn:documentation>Identity resolved (new / existing-onboarding / duplicate); branch on status.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Status_Duplicate" sourceRef="GW_IdentityStatus" targetRef="Task_WelcomeBack_Duplicate">
      <bpmn:documentation>Already-onboarded user; send Welcome Back and terminate.</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">User already onboarded (profile.status == 'onboarded')</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Dup_To_E8" sourceRef="Task_WelcomeBack_Duplicate" targetRef="EndEvent_DuplicateNumber">
      <bpmn:documentation>Welcome Back sent; terminate at E8.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Status_Onboarding" sourceRef="GW_IdentityStatus" targetRef="GW_ResumeRouter">
      <bpmn:documentation>Route to resume router to determine starting step.</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">New user OR onboarding-in-progress (profile.status == 'onboarding_started' OR isNew == true)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Resume_S2" sourceRef="GW_ResumeRouter" targetRef="Task_Step2_Welcome">
      <bpmn:documentation>Start from beginning: send welcome message.</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Last completed step is 0 (new user, nothing done)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Resume_S3" sourceRef="GW_ResumeRouter" targetRef="Task_Step3_ConsentSend">
      <bpmn:documentation>Resume from consent request.</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Last completed step is 2 (welcome already sent)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Resume_S4" sourceRef="GW_ResumeRouter" targetRef="Task_Step4_GoalSend">
      <bpmn:documentation>Resume from goal selection.</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Last completed step is 3 (consent already given)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Resume_S5" sourceRef="GW_ResumeRouter" targetRef="Task_Step5_RoleSend">
      <bpmn:documentation>Resume from role selection.</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Last completed step is 4 (goal already captured)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Resume_S6" sourceRef="GW_ResumeRouter" targetRef="Task_Step6_LocSend">
      <bpmn:documentation>Resume from location capture.</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Last completed step is 5 (role already captured)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Resume_S7" sourceRef="GW_ResumeRouter" targetRef="Task_Step7_Persistence">
      <bpmn:documentation>Resume from profile persistence.</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Last completed step is 6 (location captured, but profile not yet persisted)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S2_To_S3Send" sourceRef="Task_Step2_Welcome" targetRef="Task_Step3_ConsentSend">
      <bpmn:documentation>Welcome sent; proceed to consent request.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S3Send_To_S3Recv" sourceRef="Task_Step3_ConsentSend" targetRef="Task_Step3_ConsentRecv">
      <bpmn:documentation>Consent request sent; wait for user reply.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S3Recv_To_S3Eval" sourceRef="Task_Step3_ConsentRecv" targetRef="Task_Step3_Eval">
      <bpmn:documentation>User replied to consent request; evaluate.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S3Eval_To_GW" sourceRef="Task_Step3_Eval" targetRef="GW_ConsentResult">
      <bpmn:documentation>Consent parsed; branch on result.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Consent_No" sourceRef="GW_ConsentResult" targetRef="EndEvent_ConsentDeclined">
      <bpmn:documentation>User declined consent; terminate at E3.</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">User declined consent (consentGiven == false)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Consent_Yes" sourceRef="GW_ConsentResult" targetRef="Task_Step4_GoalSend">
      <bpmn:documentation>User granted consent; proceed to goal selection.</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">User granted consent (consentGiven == true)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S4Send_To_S4Recv" sourceRef="Task_Step4_GoalSend" targetRef="Task_Step4_GoalRecv">
      <bpmn:documentation>Goal prompt sent; wait for user reply.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S4Recv_To_S4Eval" sourceRef="Task_Step4_GoalRecv" targetRef="Task_Step4_Eval">
      <bpmn:documentation>User replied with goals; parse and map to practices.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S4Eval_To_GW" sourceRef="Task_Step4_Eval" targetRef="GW_GoalResult">
      <bpmn:documentation>Goal parse complete; branch on validity and retry count.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S4_Retry" sourceRef="GW_GoalResult" targetRef="Task_Step4_GoalSend">
      <bpmn:documentation>Re-send goal prompt with clarification.</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Parse failed AND retry count &lt; 2 (isValid == false AND retryCount &lt; 2)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S4_Pass" sourceRef="GW_GoalResult" targetRef="Task_Step5_RoleSend">
      <bpmn:documentation>Goals captured (or defaults applied); proceed to role selection.</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Parse succeeded OR max retries reached (isValid == true OR retryCount &gt;= 2)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S5Send_To_S5Recv" sourceRef="Task_Step5_RoleSend" targetRef="Task_Step5_RoleRecv">
      <bpmn:documentation>Role prompt sent; wait for user reply.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S5Recv_To_S5Eval" sourceRef="Task_Step5_RoleRecv" targetRef="Task_Step5_Eval">
      <bpmn:documentation>User replied with role; parse.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S5Eval_To_GW" sourceRef="Task_Step5_Eval" targetRef="GW_RoleResult">
      <bpmn:documentation>Role parse complete; branch.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S5_Retry" sourceRef="GW_RoleResult" targetRef="Task_Step5_RoleSend">
      <bpmn:documentation>Re-send role prompt with clarification.</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Parse failed AND retry count &lt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S5_Pass" sourceRef="GW_RoleResult" targetRef="Task_Step6_LocSend">
      <bpmn:documentation>Role captured; proceed to location capture.</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Parse succeeded OR max retries reached</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S6Send_To_S6Recv" sourceRef="Task_Step6_LocSend" targetRef="Task_Step6_LocRecv">
      <bpmn:documentation>Location prompt sent; wait for user reply.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S6Recv_To_S6Eval" sourceRef="Task_Step6_LocRecv" targetRef="Task_Step6_Eval">
      <bpmn:documentation>User replied with location (or 'skip'); evaluate.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S6_Pass" sourceRef="Task_Step6_Eval" targetRef="Task_Step7_Persistence">
      <bpmn:documentation>Location processed; proceed to profile persistence.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S7_To_S8" sourceRef="Task_Step7_Persistence" targetRef="Task_Step8_ConfirmationMsg">
      <bpmn:documentation>Profile persisted with status='onboarded'; generate confirmation message.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S8_To_S8QA" sourceRef="Task_Step8_ConfirmationMsg" targetRef="Task_Step8_QA">
      <bpmn:documentation>LLM-generated confirmation; pass through Response Quality Check.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S8QA_To_S8Send" sourceRef="Task_Step8_QA" targetRef="Task_Step8_Send">
      <bpmn:documentation>Confirmation approved by RQC; deliver to user.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S8_To_S9" sourceRef="Task_Step8_Send" targetRef="Task_Step9_FirstPrompt">
      <bpmn:documentation>Confirmation delivered; send first coaching prompt.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S9_To_GWFinal" sourceRef="Task_Step9_FirstPrompt" targetRef="GW_FinalRouting">
      <bpmn:documentation>First coaching prompt sent; route to terminal end event based on profile state.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Final_Normal" sourceRef="GW_FinalRouting" targetRef="EndEvent_CompletedFirstTry">
      <bpmn:documentation>User completed onboarding in one go. Emit OnboardingCompleted signal.</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Normal completion (needs_profile_review == false AND isResumed == false)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Final_Resumed" sourceRef="GW_FinalRouting" targetRef="EndEvent_CompletedResume">
      <bpmn:documentation>User picked up from a prior attempt and finished. Emit OnboardingCompleted signal.</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Resumed completion (needs_profile_review == false AND isResumed == true)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Final_Degraded" sourceRef="GW_FinalRouting" targetRef="EndEvent_Degraded">
      <bpmn:documentation>User completed but defaults were applied; flagged for review. Emit OnboardingCompleted signal.</bpmn:documentation>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Degraded completion (needs_profile_review == true)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T4_S3" sourceRef="Timer_4h_S3" targetRef="Task_Nudge4h">
      <bpmn:documentation>4h elapsed without user reply at consent step; send gentle nudge.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T4_S4" sourceRef="Timer_4h_S4" targetRef="Task_Nudge4h">
      <bpmn:documentation>4h elapsed without user reply at goal step.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T4_S5" sourceRef="Timer_4h_S5" targetRef="Task_Nudge4h">
      <bpmn:documentation>4h elapsed without user reply at role step.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T4_S6" sourceRef="Timer_4h_S6" targetRef="Task_Nudge4h">
      <bpmn:documentation>4h elapsed without user reply at location step.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_N4_End" sourceRef="Task_Nudge4h" targetRef="EndEvent_Nudge4h">
      <bpmn:documentation>4h nudge sent; nudge sub-flow ends. Main flow continues at parent receive task.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T48_S3" sourceRef="Timer_48h_S3" targetRef="Task_Nudge48h">
      <bpmn:documentation>48h elapsed without user reply at consent step; send second nudge with re-engagement hook.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T48_S4" sourceRef="Timer_48h_S4" targetRef="Task_Nudge48h">
      <bpmn:documentation>48h elapsed without user reply at goal step.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T48_S5" sourceRef="Timer_48h_S5" targetRef="Task_Nudge48h">
      <bpmn:documentation>48h elapsed without user reply at role step.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T48_S6" sourceRef="Timer_48h_S6" targetRef="Task_Nudge48h">
      <bpmn:documentation>48h elapsed without user reply at location step.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_N48_End" sourceRef="Task_Nudge48h" targetRef="EndEvent_Nudge48h">
      <bpmn:documentation>48h nudge sent; sub-flow ends.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T7_S3" sourceRef="Timer_7d_S3" targetRef="GW_DormantMerge">
      <bpmn:documentation>7d elapsed at consent step; cancel parent receive and route to dormant.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T7_S4" sourceRef="Timer_7d_S4" targetRef="GW_DormantMerge">
      <bpmn:documentation>7d elapsed at goal step; cancel parent receive.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T7_S5" sourceRef="Timer_7d_S5" targetRef="GW_DormantMerge">
      <bpmn:documentation>7d elapsed at role step; cancel parent receive.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T7_S6" sourceRef="Timer_7d_S6" targetRef="GW_DormantMerge">
      <bpmn:documentation>7d elapsed at location step; cancel parent receive.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_To_E4" sourceRef="GW_DormantMerge" targetRef="EndEvent_Dormant">
      <bpmn:documentation>Dormant timer fired from any receive task; terminate at E4.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Err_S2" sourceRef="Error_WA_S2" targetRef="GW_ErrorMerge">
      <bpmn:documentation>WhatsApp API failure during welcome message; route to incident.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Err_S7" sourceRef="Error_DB_S7" targetRef="GW_ErrorMerge">
      <bpmn:documentation>Database failure during profile persistence; route to incident.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Err_S8" sourceRef="Error_LLM_S8" targetRef="GW_ErrorMerge">
      <bpmn:documentation>LLM failure during confirmation generation; route to incident.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GWError_To_Incident" sourceRef="GW_ErrorMerge" targetRef="Task_IncidentHandling">
      <bpmn:documentation>Error converged; invoke incident handling.</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Incident_To_E6" sourceRef="Task_IncidentHandling" targetRef="EndEvent_ServiceError">
      <bpmn:documentation>Incident logged; terminate at E6.</bpmn:documentation>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Onboarding">
    <bpmndi:BPMNPlane id="BPMNPlane_Onboarding" bpmnElement="Collaboration_Hogaan_Onboarding">
      <bpmndi:BPMNShape id="Pool_di" bpmnElement="Participant_Hogaan" isHorizontal="true">
        <dc:Bounds x="50" y="50" width="4500" height="1300" />
      </bpmndi:BPMNShape>
