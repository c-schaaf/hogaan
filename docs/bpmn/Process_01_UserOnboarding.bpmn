        <dc:Bounds x="80" y="50" width="4470" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_OrchestrationEngine_di" bpmnElement="Lane_OrchestrationEngine" isHorizontal="true">
        <dc:Bounds x="80" y="350" width="4470" height="500" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_LLMService_di" bpmnElement="Lane_LLMService" isHorizontal="true">
        <dc:Bounds x="80" y="850" width="4470" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_DataLayer_di" bpmnElement="Lane_DataLayer" isHorizontal="true">
        <dc:Bounds x="80" y="1000" width="4470" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ExternalServices_di" bpmnElement="Lane_ExternalServices" isHorizontal="true">
        <dc:Bounds x="80" y="1200" width="4470" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_WhatsApp_di" bpmnElement="StartEvent_WhatsApp">
        <dc:Bounds x="130" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="100" y="193" width="100" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Web_di" bpmnElement="StartEvent_Web">
        <dc:Bounds x="130" y="532" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="100" y="573" width="100" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Step1_IdentityResolution_di" bpmnElement="Task_Step1_IdentityResolution">
        <dc:Bounds x="210" y="1040" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_IdentityStatus_di" bpmnElement="GW_IdentityStatus" isMarkerVisible="true">
        <dc:Bounds x="380" y="525" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="355" y="500" width="100" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_WelcomeBack_Duplicate_di" bpmnElement="Task_WelcomeBack_Duplicate">
        <dc:Bounds x="350" y="250" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_DuplicateNumber_di" bpmnElement="EndEvent_DuplicateNumber">
        <dc:Bounds x="510" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="480" y="313" width="100" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_ResumeRouter_di" bpmnElement="GW_ResumeRouter" isMarkerVisible="true">
        <dc:Bounds x="490" y="525" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="465" y="500" width="100" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Step2_Welcome_di" bpmnElement="Task_Step2_Welcome">
        <dc:Bounds x="600" y="130" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Error_WA_S2_di" bpmnElement="Error_WA_S2">
        <dc:Bounds x="660" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="630" y="233" width="100" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Step3_ConsentSend_di" bpmnElement="Task_Step3_ConsentSend">
        <dc:Bounds x="760" y="130" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Step3_ConsentRecv_di" bpmnElement="Task_Step3_ConsentRecv">
