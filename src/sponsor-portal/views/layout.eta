<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= it.title %> · Hogaan sponsor portal</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; margin: 0; padding: 0; background: #f6f6f4; color: #222; }
    header { background: #222; color: #fff; padding: 16px 32px; }
    header h1 { margin: 0; font-size: 20px; font-weight: 600; }
    header .meta { font-size: 12px; opacity: 0.7; margin-top: 4px; }
    nav { background: #fff; border-bottom: 1px solid #e2e2dc; padding: 0 32px; }
    nav a { display: inline-block; padding: 12px 16px; color: #222; text-decoration: none; border-bottom: 2px solid transparent; }
    nav a.active { border-bottom-color: #222; font-weight: 600; }
    main { max-width: 960px; margin: 0 auto; padding: 32px; }
    h2 { margin-top: 32px; font-size: 18px; }
    table { width: 100%; border-collapse: collapse; background: #fff; }
    th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid #e2e2dc; font-size: 14px; }
    th { background: #f0f0eb; font-weight: 600; }
    .suppressed { background: #fff8e1; padding: 16px; border-left: 4px solid #d4a017; font-size: 14px; color: #5b4a00; margin: 12px 0; border-radius: 2px; }
    .kv { display: grid; grid-template-columns: max-content 1fr; gap: 4px 24px; font-size: 14px; }
    .kv dt { color: #666; }
    .kv dd { margin: 0; font-weight: 600; }
    form { background: #fff; padding: 24px; border: 1px solid #e2e2dc; border-radius: 4px; max-width: 420px; margin: 64px auto; }
    input[type="email"] { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 3px; font-size: 14px; box-sizing: border-box; }
    button { background: #222; color: #fff; border: 0; padding: 10px 20px; font-size: 14px; border-radius: 3px; cursor: pointer; margin-top: 12px; }
    .pct { font-variant-numeric: tabular-nums; color: #5a8c4a; font-weight: 600; }
    .num { font-variant-numeric: tabular-nums; }
  </style>
</head>
<body>
  <header>
    <h1>Hogaan sponsor portal</h1>
    <% if (it.session) { %>
    <div class="meta">Signed in: <%= it.session.email %> · <%= it.session.role %></div>
    <% } %>
  </header>
  <% if (it.session) { %>
  <nav>
    <a href="/portal/dashboard" class="<%= it.active === 'dashboard' ? 'active' : '' %>">Cohort</a>
    <a href="/portal/engagement" class="<%= it.active === 'engagement' ? 'active' : '' %>">Engagement</a>
    <a href="/portal/qc" class="<%= it.active === 'qc' ? 'active' : '' %>">Quality &amp; safety</a>
  </nav>
  <% } %>
  <main>
    <%~ it.body %>
  </main>
</body>
</html>
