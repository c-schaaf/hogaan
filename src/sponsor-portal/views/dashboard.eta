<h2>Cohort overview</h2>

<% if (it.seats.length === 0) { %>
  <p style="color:var(--ink-2);">No cohorts visible at your access level.</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>Cohort</th>
        <th class="num">Seats</th>
        <th class="num">Redeemed</th>
        <th class="num">Unredeemed</th>
        <th class="num">Expired</th>
        <th class="num">Revoked</th>
        <th class="num">Redemption</th>
      </tr>
    </thead>
    <tbody>
      <% it.seats.forEach(function(s) { %>
        <tr>
          <td><%= s.cohortName %></td>
          <td class="num"><%= s.seatCount %></td>
          <td class="num"><%= s.redeemed %></td>
          <td class="num"><%= s.unredeemed %></td>
          <td class="num"><%= s.expired %></td>
          <td class="num"><%= s.revoked %></td>
          <td class="pct"><%= (s.redemptionRate * 100).toFixed(1) %>%</td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<h2>Redemption velocity (last 30 days)</h2>
<% if (it.velocity.length === 0) { %>
  <p style="color:var(--ink-2);">No redemptions in the last 30 days.</p>
<% } else { %>
  <table>
    <thead>
      <tr><th>Date</th><th class="num">Redemptions</th></tr>
    </thead>
    <tbody>
      <% it.velocity.forEach(function(v) { %>
        <tr><td><%= v.date %></td><td class="num"><%= v.redemptions %></td></tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<h2>Geography breakdown</h2>
<% if (it.geography.length === 0) { %>
  <p style="color:var(--ink-2);">No geographies recorded.</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>Geography</th>
        <th class="num">Cohorts</th>
        <th class="num">Total seats</th>
        <th class="num">Redeemed</th>
      </tr>
    </thead>
    <tbody>
      <% it.geography.forEach(function(g) { %>
        <tr>
          <td><%= g.geography %></td>
          <td class="num"><%= g.cohorts %></td>
          <td class="num"><%= g.totalSeats %></td>
          <td class="num"><%= g.totalRedeemed %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
