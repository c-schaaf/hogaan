<h2>Quality assurance (last 30 days)</h2>

<% if (it.qc.suppressed) { %>
  <div class="suppressed"><%= it.qc.copy %></div>
<% } else { %>
  <dl class="kv">
    <dt>Total turns</dt><dd class="num"><%= it.qc.value.totalTurns %></dd>
    <dt>Approved turns</dt><dd class="num"><%= it.qc.value.approvedTurns %></dd>
    <dt>Pass rate</dt><dd class="pct"><%= (it.qc.value.passRate * 100).toFixed(1) %>%</dd>
    <dt>Degraded turns</dt><dd class="num"><%= it.qc.value.degradedTurns %></dd>
    <dt>Retry rate</dt><dd class="pct"><%= (it.qc.value.retryRate * 100).toFixed(1) %>%</dd>
  </dl>
<% } %>

<h2>Crisis events by category (last 30 days)</h2>
<p style="color:var(--ink-2);font-size:13px;">No transcripts. Counts only. The privacy floor below is enforced over baseline cohort engagement.</p>
<% if (it.crisis.suppressed) { %>
  <div class="suppressed"><%= it.crisis.copy %></div>
<% } else if (it.crisis.value.length === 0) { %>
  <p style="color:var(--ink-2);">No crisis events in the window.</p>
<% } else { %>
  <table>
    <thead><tr><th>Category</th><th class="num">Events</th></tr></thead>
    <tbody>
      <% it.crisis.value.forEach(function(c) { %>
        <tr><td><%= c.category %></td><td class="num"><%= c.count %></td></tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
